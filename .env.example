# Copy to /etc/codex-discord-bot.env, edit, and chmod 600. Never commit real values.
# Values must be literal: systemd does not expand $HOME or ~ here.
DATABASE_URL=postgres://codex_bot:REPLACE_ME@127.0.0.1:5432/codex_bot
DISCORD_TOKEN=REPLACE_ME
ALLOWED_USER_IDS=123456789012345678
DISCORD_GUILD_ID=234567890123456789
# Categories must already exist in the configured guild.
DISCORD_ACTIVE_CATEGORY_ID=456789012345678901
DISCORD_COMPLETED_CATEGORY_ID=567890123456789012
# Optional: reuse this text channel. If omitted, find/create #codex-control.
# DISCORD_CHANNEL_ID remains supported as the legacy alias for this setting.
DISCORD_CONTROL_CHANNEL_ID=345678901234567890
DISCORD_TASK_RETENTION_HOURS=48

REPOS_ROOT=/repos
STATE_DIR=/var/lib/codex-discord-bot
# Use the absolute executable already installed on your VM; it must be version 0.162.1.
CODEX_BIN=/home/codexbot/.local/bin/codex
CODEX_HOME=/home/codexbot/.codex
# Include every compiler/package manager needed by your projects. No login shell is run.
TOOL_PATH=/home/codexbot/.cargo/bin:/home/codexbot/.local/bin:/usr/local/bin:/usr/bin:/bin
# Queued issues require trusted build/test/lint checks before integration/completion.
# Root-owned JSON outside repositories; see deploy/validation.example.json and README.
# Empty disables validation setup and blocks queued issues after implementation.
VALIDATION_CONFIG=
# Opt-in automatic PR integration. Root-owned policy also attests release gating.
# See deploy/integration.example.json and the setup requirements in README.
# Empty blocks integration without publishing a branch or creating a PR.
INTEGRATION_CONFIG=
# Releases use a separate Unix account and service; see deploy/release.env.example.
# Never give this bot/Codex account the release controller's Actions-write token.
# Durable worker admission limits (1–32); both default to one.
# Active, blocked and release-pending attempts retain their slots until reviewed.
# Size the service CPUQuota, MemoryMax and TasksMax before raising these limits.
ISSUE_WORKERS_GLOBAL=1
ISSUE_WORKERS_PER_REPOSITORY=1
# Empty uses the configured Codex default.
CODEX_MODEL=
# Empty uses Codex's configured/default effort; supported levels depend on the model.
# For Astra at max effort, set CODEX_MODEL=gpt-6-astra and CODEX_REASONING_EFFORT=max.
CODEX_REASONING_EFFORT=
# Approve for me (default): Codex automatically reviews eligible approval requests.
# Set to user for manual Discord approval buttons instead.
CODEX_APPROVALS_REVIEWER=auto_review
RUST_LOG=codex_discord_bot=info,serenity=warn
# Opt in only while troubleshooting: raw Codex stderr can contain project data.
CODEX_LOG_STDERR=0
