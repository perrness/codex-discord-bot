# Install as /etc/codex-discord-release.env, owned by root with mode 0600.
# Never copy this credential into the bot environment, Codex home or a checkout.
DATABASE_URL=postgres://codex_release:REPLACE_ME@127.0.0.1:5432/codex_bot
RELEASE_CONFIG=/etc/codex-discord-bot-release.json
# Numeric output of: id -u codexbot. The controller rejects that UID and root.
CODEX_WORKER_UID=REPLACE_WITH_CODEXBOT_UID
# Dedicated GitHub identity with Actions read/write and contents read.
# Use a protected GitHub environment for production credentials; no local keys.
GH_TOKEN=REPLACE_ME
DISCORD_TASK_RETENTION_HOURS=48
RUST_LOG=codex_discord_bot=info
