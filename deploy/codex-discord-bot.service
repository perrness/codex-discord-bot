[Unit]
Description=Personal Discord Codex Agent Manager
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=codexbot
Group=codexbot
EnvironmentFile=/etc/codex-discord-bot.env
Environment=HOME=/home/codexbot
WorkingDirectory=/var/lib/codex-discord-bot
StateDirectory=codex-discord-bot
StateDirectoryMode=0700
ExecStart=/usr/local/bin/codex-discord-bot run
Restart=on-failure
RestartSec=10
KillMode=control-group
# Aggregate limits include Codex, checks, Git, and all worker descendants.
# Tune these together with ISSUE_WORKERS_* for the VM using a systemd drop-in.
CPUQuota=200%
MemoryHigh=3G
MemoryMax=4G
TasksMax=512
LimitNOFILE=8192
OOMPolicy=stop
TimeoutStopSec=20
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
